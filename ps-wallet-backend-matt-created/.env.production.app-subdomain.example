# Wallet — production @ https://app.pinksurfing.com
# Copy: cp .env.production.app-subdomain.example .env

PORT=3099
KEYVAULT_PYTHON_URL=http://127.0.0.1:5002
CHIA_USE_REMOTE=true
CHIA_NETWORK=testnet10

CORS_ORIGINS=https://app.pinksurfing.com
GOOGLE_REDIRECT_URI=https://app.pinksurfing.com/api/wallet/auth/google/callback

# Production IPFS — set PINATA_JWT from Pinata dashboard
IPFS_PROVIDER=pinata
PINATA_JWT=

# CRITICAL — generate once, back up: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_ENCRYPTION_KEY=

# Google Drive OAuth (fill before deploy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chia RPC — set paths for your VPS node
CHIA_RPC_HOST=https://127.0.0.1:8555
CHIA_WALLET_RPC_HOST=https://127.0.0.1:9256
CHIA_RPC_CERT_PATH=
CHIA_RPC_KEY_PATH=
CHIA_WALLET_CERT_PATH=
CHIA_WALLET_KEY_PATH=
