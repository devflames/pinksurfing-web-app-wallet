# Server
PORT=3099

# Optional: override public URL shown in Swagger "Servers" dropdown
# API_DOCS_PUBLIC_URL=https://app.pinksurfing.com/api/wallet

# CORS — comma-separated origins in production
# Prod @ app.pinksurfing.com:
# CORS_ORIGINS=https://app.pinksurfing.com
# Dev:
CORS_ORIGINS=*

# Google OAuth2 (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3099/auth/google/callback
# Production @ app.pinksurfing.com:
# GOOGLE_REDIRECT_URI=https://app.pinksurfing.com/api/wallet/auth/google/callback

# Chia RPC (local full node or remote)
CHIA_RPC_HOST=https://localhost:8555
CHIA_RPC_CERT_PATH=~/.chia/mainnet/config/ssl/full_node/private_full_node.crt
CHIA_RPC_KEY_PATH=~/.chia/mainnet/config/ssl/full_node/private_full_node.key

# Use testnet for development
CHIA_NETWORK=testnet10
# Wallet RPC for spending
CHIA_WALLET_RPC_HOST=https://localhost:9256
CHIA_WALLET_CERT_PATH=~/.chia/mainnet/config/ssl/wallet/private_wallet.crt
CHIA_WALLET_KEY_PATH=~/.chia/mainnet/config/ssl/wallet/private_wallet.key

# KeyVault Python sidecar (Chia blockchain operations) — REQUIRED for KeyVault/PayChat chain ops
KEYVAULT_PYTHON_URL=http://localhost:5002
# Legacy alias (paychat-service also accepts this):
# KEYVAULT_SIDECAR_URL=http://localhost:5002

# Python sidecar — Chia full node for deploy-server-funded (optional)
# CHIA_FULL_NODE_HOST=127.0.0.1
# CHIA_FULL_NODE_PORT=8555
# CHIA_USE_REMOTE=false
# SERVER_KEY_FINGERPRINT=

# Server-side encryption key — 64-char hex (256-bit). Encrypts recovery key shares at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Back this up! If lost, all escrowed vault keys become unrecoverable.
# Legacy alias RECOVERY_MASTER_KEY is also accepted by recovery-service.js.
SERVER_ENCRYPTION_KEY=

# IPFS Pinning — profile data is pinned to IPFS, NFT metadata points to ipfs://CID
# Provider options: pinata, local, data_uri (fallback — NOT for production)
IPFS_PROVIDER=data_uri
# Pinata (recommended for production — get JWT from https://app.pinata.cloud)
PINATA_JWT=your-pinata-jwt-token
# Local IPFS node (for development — run `ipfs daemon` first)
IPFS_LOCAL_API=http://localhost:5001

# Email OTP (optional — logs OTP to console if unset)
# SENDGRID_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@pinksurfing.com

# Agora RTC (optional — /calls/token)
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=

# Firebase push (optional)
# FCM_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
