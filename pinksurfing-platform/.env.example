# PinkSurfing platform — environment reference
# Production: see docs/OFFICIAL_BACKEND_CONNECTIONS.md
#
# THREE env files:
#   1. pinksurfing-platform/.env           → NestJS gateway
#   2. apps/web/.env.local                 → Next.js web
#   3. PS-App-Backend/*/.env               → Official Raihan (separate repo)
#
# Templates:
#   Local dev:     apps/api/.env.example + apps/web/.env.example
#   Production:    apps/api/.env.production.example + apps/web/.env.production.example

# ═══════════════════════════════════════════════════════════
# LOCAL DEV (smoke stack + gateway)
# Copy to .env for gateway, apps/web/.env.local for web
# ═══════════════════════════════════════════════════════════

PORT=8080
APP_API_URL=http://127.0.0.1:6003
WALLET_API_URL=http://127.0.0.1:3099
ADMIN_API_URL=http://127.0.0.1:6001

# Web (apps/web/.env.local):
# NEXT_PUBLIC_AUTH_MODE=local
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/app
# NEXT_PUBLIC_WALLET_URL=http://localhost:8080/api/wallet
# JWT_SECRET=sso_secret_key_for_jwt_decoding
# DEV_USER_ID=web-user-a

# ═══════════════════════════════════════════════════════════
# PRODUCTION — https://pinksurfing.com/app
# Copy from apps/api/.env.production.example + apps/web/.env.production.example
# ═══════════════════════════════════════════════════════════

# PORT=8080
# APP_API_URL=http://127.0.0.1:6003
# WALLET_API_URL=http://127.0.0.1:3099
# ADMIN_API_URL=http://127.0.0.1:6001
# CORS_ORIGINS=https://pinksurfing.com,https://www.pinksurfing.com

# NEXT_PUBLIC_BASE_PATH=/app
# NEXT_PUBLIC_AUTH_MODE=production
# NEXT_PUBLIC_API_URL=https://pinksurfing.com/api/app
# NEXT_PUBLIC_WALLET_URL=https://pinksurfing.com/api/wallet
# AUTH_TOKEN_URL=https://auth.pinksurfing.com/api/token/
# APP_API_URL=http://127.0.0.1:6003

# ═══════════════════════════════════════════════════════════
# PRODUCTION — existing PinkSurfing hosts (remote official APIs)
# Use only if raihan branch is already deployed there
# ═══════════════════════════════════════════════════════════

# NEXT_PUBLIC_API_URL=https://mobileapi.pinksurfing.com
# NEXT_PUBLIC_WALLET_URL=https://api.pinksurfing.com
# AUTH_TOKEN_URL=https://auth.pinksurfing.com/api/token/
