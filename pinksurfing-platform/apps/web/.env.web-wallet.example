# Web — web + Matt wallet only (single server, no Raihan on host)
# Copy: cp apps/web/.env.web-wallet.example apps/web/.env.local
# Then: npm run build -w @pinksurfing/web
#
# Login uses external SSO (auth.pinksurfing.com). Profile sync to Raihan is SKIPPED
# when mobileapi is unreachable — set SSO_SYNC_OPTIONAL=true.

NEXT_PUBLIC_BASE_PATH=/app
NEXT_PUBLIC_AUTH_MODE=production
NEXT_PUBLIC_APP_ORIGIN=https://pinksurfing.com

# Wallet + gateway on same host (Caddy → :3000 web, :8080 gateway)
NEXT_PUBLIC_API_URL=https://pinksurfing.com/api/app
NEXT_PUBLIC_WALLET_URL=https://pinksurfing.com/api/wallet
NEXT_PUBLIC_WALLET_LIVE=true
NEXT_PUBLIC_CONTRACTS_LIVE=false
NEXT_PUBLIC_CHAT_LIVE=false
NEXT_PUBLIC_GOOGLE_AUTH=true

# External SSO (Arshad host — not on this machine)
AUTH_TOKEN_URL=https://auth.pinksurfing.com/api/token/
AUTH_GOOGLE_TOKEN_URL=https://auth.pinksurfing.com/api/auth/google/mobile/

# Raihan not on this server — skip create-customer-from-sso failure if JWT has user_id
SSO_SYNC_OPTIONAL=true
# APP_API_URL unset — sync skipped when optional

# Google OAuth (web login) — fill before go-live
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pinksurfing.com/app/api/auth/google/callback

NEXT_PUBLIC_AGORA_APP_ID=
