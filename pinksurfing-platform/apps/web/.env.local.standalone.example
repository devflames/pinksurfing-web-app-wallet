# Standalone unified stack — all services on localhost, no production auth host.
# Used by scripts/start-full-stack-linux.sh (default mode).
#
# SSO is proxied on the same host via Caddy (:8888) so HttpOnly cookies work.

NEXT_PUBLIC_BASE_PATH=/app
NEXT_PUBLIC_APP_ORIGIN=http://localhost:8888

NEXT_PUBLIC_AUTH_MODE=production
NEXT_PUBLIC_GOOGLE_AUTH=true

# SSO via Caddy proxy (same origin as /app)
AUTH_TOKEN_URL=http://localhost:8888/api/token/
AUTH_GOOGLE_TOKEN_URL=http://localhost:8888/api/auth/google/mobile/
NEXT_PUBLIC_SSO_GOOGLE_START_URL=http://localhost:8888/api/auth/google/
APP_API_URL=http://127.0.0.1:6003
NEXT_PUBLIC_API_URL=http://localhost:8888/api/app
NEXT_PUBLIC_WALLET_URL=http://localhost:8888/api/wallet
JWT_SECRET=sso_secret_key_for_jwt_decoding

# Google OAuth — filled from secrets/google-oauth.local.env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8888/api/auth/google/callback/
GOOGLE_CLIENT_IDS=

NEXT_PUBLIC_AGORA_APP_ID=6633314fbbcf41f8a2c73dac26dd8552
NEXT_PUBLIC_CALLS_DEMO=true
NEXT_PUBLIC_CHAT_LIVE=true
NEXT_PUBLIC_CONTRACTS_LIVE=true

# Smoke mobileapi lacks create-customer-from-sso — allow SSO login without Raihan sync
SSO_SYNC_OPTIONAL=true

# Demo login (seeded by local SSO): demo@pinksurfing.com / PinkSurfingDemo1!

# Didit KYC — proxied identity API (when stack includes docker-pinksurfing-prod identity app)
# NEXT_PUBLIC_IDENTITY_API_URL=http://localhost:8888/api/identity
