# Next.js web — copy to apps/web/.env.local
# Official backends: docs/OFFICIAL_BACKEND_CONNECTIONS.md
# Production template: .env.production.example

# ─── Local dev (smoke + gateway) ───
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_API_URL=http://localhost:8080/api/app
NEXT_PUBLIC_WALLET_URL=http://localhost:8080/api/wallet
JWT_SECRET=sso_secret_key_for_jwt_decoding
DEV_USER_ID=web-user-a

# Agora RTC (same App ID as Raihan mobileapi / Flutter)
NEXT_PUBLIC_AGORA_APP_ID=6633314fbbcf41f8a2c73dac26dd8552
# When true, skip /chat/calls/initiate if Raihan chat DB unavailable — still fetches RTC token
NEXT_PUBLIC_CALLS_DEMO=true

# NEXT_PUBLIC_DEV_CHIA_ADDRESS=xch1...
# NEXT_PUBLIC_WALLET_LIVE=true

# Live Raihan chat (contactList, messages, uploadAttachment) — requires gateway + chat backend
# NEXT_PUBLIC_CHAT_LIVE=true

# Didit KYC (Django identity API — same email-scoped verification as ecommerce)
# NEXT_PUBLIC_IDENTITY_API_URL=https://pinksurfing.com/api/identity

# ─── Production (self-hosted official stack on your server) ───
# Copy from .env.production.example — set NEXT_PUBLIC_AUTH_MODE=production
# AUTH_TOKEN_URL=https://auth.pinksurfing.com/api/token/
# AUTH_GOOGLE_TOKEN_URL=https://auth.pinksurfing.com/api/token/google/
# NEXT_PUBLIC_GOOGLE_AUTH=true
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...                    # server only
# GOOGLE_REDIRECT_URI=https://pinksurfing.com/app/api/auth/google/callback
# APP_API_URL=http://127.0.0.1:6003

# ─── Production (remote official PinkSurfing APIs) ───
# NEXT_PUBLIC_AUTH_MODE=production
# NEXT_PUBLIC_API_URL=https://mobileapi.pinksurfing.com
# NEXT_PUBLIC_WALLET_URL=https://api.pinksurfing.com
# AUTH_TOKEN_URL=https://auth.pinksurfing.com/api/token/
# APP_API_URL=https://mobileapi.pinksurfing.com
