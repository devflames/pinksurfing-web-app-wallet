# Web — production @ https://app.pinksurfing.com (Contabo VPS)
# Deploy repos: pinksurfing-platform + ps-wallet-backend-matt-created ONLY.
# Raihan (coreapi), SSO (auth), marketplace (pinksurfing.com) are on other servers.
# Copy: cp apps/web/.env.app-subdomain.example apps/web/.env.local

# Empty base path — app lives at subdomain root, not /app
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_AUTH_MODE=production
NEXT_PUBLIC_APP_ORIGIN=https://app.pinksurfing.com

# Same-origin via gateway (gateway APP_API_URL → coreapi.pinksurfing.com)
NEXT_PUBLIC_API_URL=https://app.pinksurfing.com/api/app
NEXT_PUBLIC_WALLET_URL=https://app.pinksurfing.com/api/wallet

# Live backends — enabled for production deploy
NEXT_PUBLIC_WALLET_LIVE=true
NEXT_PUBLIC_CHAT_LIVE=true
NEXT_PUBLIC_CONTRACTS_LIVE=true
NEXT_PUBLIC_GOOGLE_AUTH=true
NEXT_PUBLIC_CALLS_DEMO=false

# SSO (remote — auth.pinksurfing.com)
AUTH_TOKEN_URL=https://auth.pinksurfing.com/api/token/
AUTH_GOOGLE_TOKEN_URL=https://auth.pinksurfing.com/api/auth/google/mobile/
NEXT_PUBLIC_SSO_GOOGLE_START_URL=https://auth.pinksurfing.com/api/auth/google/
APP_API_URL=https://coreapi.pinksurfing.com
SSO_SYNC_OPTIONAL=true
JWT_SECRET=

# Testnet addresses use txch prefix; mainnet use xch
NEXT_PUBLIC_WALLET_ADDRESS_PREFIX=txch

# Google OAuth (fill before deploy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.pinksurfing.com/api/auth/google/callback

NEXT_PUBLIC_AGORA_APP_ID=
