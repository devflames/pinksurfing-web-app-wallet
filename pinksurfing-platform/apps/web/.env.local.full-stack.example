# Local full stack — mirrors https://pinksurfing.com routing
#   http://localhost:8888/      → marketplace (docker-pinksurfing-prod-main :8000)
#   http://localhost:8888/app   → Next.js web (this repo)
#   http://localhost:8888/api/* → NestJS gateway :8080
#
# Copy to apps/web/.env.local when using scripts/start-full-stack-linux.sh

NEXT_PUBLIC_BASE_PATH=/app
NEXT_PUBLIC_APP_ORIGIN=http://localhost:8888

NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_API_URL=http://localhost:8888/api/app
NEXT_PUBLIC_WALLET_URL=http://localhost:8888/api/wallet
JWT_SECRET=sso_secret_key_for_jwt_decoding
DEV_USER_ID=web-user-a

NEXT_PUBLIC_AGORA_APP_ID=6633314fbbcf41f8a2c73dac26dd8552
NEXT_PUBLIC_CALLS_DEMO=true

# Live features when smoke/official backends are up:
# NEXT_PUBLIC_CHAT_LIVE=true
# NEXT_PUBLIC_CONTRACTS_LIVE=true

# Production SSO on same layout (mobileapi must run on :6003):
# NEXT_PUBLIC_AUTH_MODE=production
# AUTH_TOKEN_URL=https://auth.pinksurfing.com/api/token/
# APP_API_URL=http://127.0.0.1:6003
