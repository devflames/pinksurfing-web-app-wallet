# Web — production @ https://pinksurfing.com/app
# Copy to apps/web/.env.local (or .env.production) on server before build
#
# Client URL: https://pinksurfing.com/app  (marketplace / app shell)
# Build MUST set NEXT_PUBLIC_BASE_PATH=/app

NEXT_PUBLIC_BASE_PATH=/app
NEXT_PUBLIC_AUTH_MODE=production

# API via same domain (Caddy routes /api/* → gateway :8080)
NEXT_PUBLIC_API_URL=https://pinksurfing.com/api/app
NEXT_PUBLIC_WALLET_URL=https://pinksurfing.com/api/wallet
NEXT_PUBLIC_WALLET_LIVE=true
NEXT_PUBLIC_CONTRACTS_LIVE=true
NEXT_PUBLIC_CHAT_LIVE=true
NEXT_PUBLIC_CALLS_DEMO=false
NEXT_PUBLIC_GOOGLE_AUTH=true
NEXT_PUBLIC_AGORA_APP_ID=6633314fbbcf41f8a2c73dac26dd8552

# Official SSO (Flutter uses same host)
AUTH_TOKEN_URL=https://auth.pinksurfing.com/api/token/
AUTH_GOOGLE_TOKEN_URL=https://auth.pinksurfing.com/api/token/google/

# Google OAuth — web app login (server-side code flow)
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://pinksurfing.com/app/api/auth/google/callback
NEXT_PUBLIC_APP_ORIGIN=https://pinksurfing.com

# Server-side — direct mobileapi on host (not public URL)
APP_API_URL=http://127.0.0.1:6003

# Gateway CORS must include https://pinksurfing.com

# ─── If API stays on api.pinksurfing.com instead ───
# NEXT_PUBLIC_API_URL=https://api.pinksurfing.com/api/app
# NEXT_PUBLIC_WALLET_URL=https://api.pinksurfing.com/api/wallet

# ─── Legacy direct mobileapi (no /api/app prefix on gateway) ───
# NEXT_PUBLIC_API_URL=https://mobileapi.pinksurfing.com
# NEXT_PUBLIC_WALLET_URL=https://api.pinksurfing.com
# APP_API_URL=https://mobileapi.pinksurfing.com
