# Cursor Cloud Agent / headless Linux — UI demo without local Raihan/Matt clones
# Copy to apps/web/.env.local when backends are NOT running on the same VM

NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_API_URL=http://localhost:8080/api/app
NEXT_PUBLIC_WALLET_URL=http://localhost:8080/api/wallet
JWT_SECRET=sso_secret_key_for_jwt_decoding
DEV_USER_ID=web-user-a

NEXT_PUBLIC_AGORA_APP_ID=6633314fbbcf41f8a2c73dac26dd8552
NEXT_PUBLIC_CALLS_DEMO=true

# Keep OFF unless Raihan mobileapi + chat are running (see /health/upstreams)
# NEXT_PUBLIC_CHAT_LIVE=true
# NEXT_PUBLIC_CONTRACTS_LIVE=true
# NEXT_PUBLIC_WALLET_LIVE=true

# ─── Production SSO login test (real auth.pinksurfing.com account) ───
# Step 1: SSO validates email/password. Step 2: web calls Raihan create-customer-from-sso.
# Without APP_API_URL, step 2 defaults to localhost:6003 and fails in cloud.
#
# NEXT_PUBLIC_AUTH_MODE=production
# AUTH_TOKEN_URL=https://auth.pinksurfing.com/api/token/
# APP_API_URL=https://mobileapi.pinksurfing.com
# NEXT_PUBLIC_API_URL=https://mobileapi.pinksurfing.com
#
# If live mobileapi is down, run local Raihan on :6003 instead:
# APP_API_URL=http://127.0.0.1:6003
#
# UI-only fallback when mobileapi unreachable (JWT must include user_id):
# SSO_SYNC_OPTIONAL=true
#
# Google (after Django SSO ships /api/token/google/):
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# AUTH_GOOGLE_TOKEN_URL=https://auth.pinksurfing.com/api/token/google/
