# Gateway — web + Matt wallet only (single server)
# Copy: cp apps/api/.env.web-wallet.example ../../.env
# Raihan routes (/api/app/*) will 502 until mobileapi is added — wallet routes work.

PORT=8080
WALLET_API_URL=http://127.0.0.1:3099
# Optional — leave unset or point at remote mobileapi if available
# APP_API_URL=http://127.0.0.1:6003
# APP_API_URL=https://mobileapi.pinksurfing.com
ADMIN_API_URL=http://127.0.0.1:6001

CORS_ORIGINS=https://pinksurfing.com,https://www.pinksurfing.com,http://localhost:3000
