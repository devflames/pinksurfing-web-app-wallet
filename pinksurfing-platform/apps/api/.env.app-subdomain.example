# Gateway — app.pinksurfing.com (web + Matt wallet on same VPS)
# Raihan is remote: APP_API_URL → coreapi.pinksurfing.com
# Copy: cp apps/api/.env.app-subdomain.example ../../.env

PORT=8080
CORS_ORIGINS=https://app.pinksurfing.com

# Local on this VPS
WALLET_API_URL=http://127.0.0.1:3099

# Remote — already deployed (do not run PS-App-Backend on this box)
APP_API_URL=https://coreapi.pinksurfing.com

# Optional — only if admin API is reachable remotely
# ADMIN_API_URL=https://...
