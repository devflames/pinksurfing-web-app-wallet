# NestJS gateway ONLY — copy to pinksurfing-platform/.env (repo root)
# Used by: npm run dev:api / start:prod -w @pinksurfing/api

PORT=8080
APP_API_URL=http://127.0.0.1:6003
WALLET_API_URL=http://127.0.0.1:3099
ADMIN_API_URL=http://127.0.0.1:6001

# Only if Docker Postgres is running (optional for contracts smoke test)
DATABASE_URL=postgresql://pinksurfing:pinksurfing_local@localhost:5432/pinksurfing
