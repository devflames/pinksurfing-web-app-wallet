# Caddy — app.pinksurfing.com (Contabo VPS)
# Marketplace stays on https://pinksurfing.com/ (other host/IP).
# Platform web + gateway + wallet on this VPS.
#
# DNS: A  app  →  173.249.48.238
#
# Copy: sudo cp Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

app.pinksurfing.com {
	# Legacy wallet docs URL → canonical /api-docs
	@legacyDocs path_regexp legacy ^/api/wallet/api-docs(.*)$
	redir @legacyDocs /api-docs{re.legacy.1} permanent

	# Wallet Swagger UI (direct to Node wallet :3099)
	handle /api-docs* {
		reverse_proxy 127.0.0.1:3099
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /health {
		reverse_proxy 127.0.0.1:8080
	}

	# Next.js at site root (NEXT_PUBLIC_BASE_PATH empty)
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
